<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.4" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>facturacion-aspire-apphost-development</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Facturacion.Api/Facturacion.Api.csproj" IsAspireProjectResource="true" />
    <ProjectReference Include="../Facturacion.Web.Public/Facturacion.Web.Public.csproj" IsAspireProjectResource="true" />
    <ProjectReference Include="../Facturacion.Web.App/Facturacion.Web.App.csproj" IsAspireProjectResource="true" />
    <ProjectReference Include="../Facturacion.Workers/Facturacion.Workers.csproj" IsAspireProjectResource="true" />
  </ItemGroup>
</Project>
