@page "/customers"
@rendermode InteractiveServer
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider Authentication
@inject IHttpClientFactory Clients

<PageTitle>Seleccionar empresa | Clientes</PageTitle>
<h1>Clientes</h1>
<p class="muted">Selecciona una empresa para gestionar su catálogo de clientes.</p>
@if (_loading)
{
    <p>Cargando empresas autorizadas…</p>
}
else if (_unauthorized)
{
    <p role="alert">Tu sesión ha caducado. <a href="/login">Inicia sesión</a>.</p>
}
else if (_error is not null)
{
    <p role="alert">@_error</p>
}
else if (_companies.Count == 0)
{
    <p>No tienes empresas activas asignadas.</p>
}
else
{
    <ul>
        @foreach (var company in _companies)
        {
            <li><a href="@($"/catalog/{company.Id:D}/customers")">@company.LegalName</a></li>
        }
    </ul>
}

@code {
    private bool _loading = true;
    private bool _unauthorized;
    private string? _error;
    private List<CompanyItem> _companies = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await Authentication.GetAuthenticationStateAsync();
        var token = state.User.FindFirstValue("api_token");
        if (state.User.Identity?.IsAuthenticated != true || string.IsNullOrWhiteSpace(token) ||
            !Guid.TryParse(state.User.FindFirstValue("tenant_id"), out _))
        {
            _unauthorized = true;
            _loading = false;
            return;
        }

        try
        {
            using var client = Clients.CreateClient("FacturacionAuthApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            using var response = await client.GetAsync("api/my/companies");
            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized) _unauthorized = true;
            else if (!response.IsSuccessStatusCode) _error = "No se pudieron consultar las empresas autorizadas.";
            else _companies = (await response.Content.ReadFromJsonAsync<CompanyEnvelope>())?.Data ?? new();
        }
        catch (HttpRequestException) { _error = "No se pudo contactar con la API."; }
        catch (System.Text.Json.JsonException) { _error = "La API devolvió una respuesta no válida."; }
        finally { _loading = false; }
    }

    private sealed record CompanyEnvelope(List<CompanyItem>? Data);
    private sealed record CompanyItem(Guid Id, string LegalName);
}
