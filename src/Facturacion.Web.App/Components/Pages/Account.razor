@page "/account"
@rendermode InteractiveServer
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider Authentication
@inject IHttpClientFactory Clients

<PageTitle>Mi cuenta | FacturaciónES</PageTitle>
<link rel="stylesheet" href="/_content/Facturacion.UI.Shared/account.css" />

@if (_loading)
{
    <section class="account-panel"><p>Cargando tu perfil…</p></section>
}
else if (_unauthorized)
{
    <section class="account-panel"><p>Tu sesión ha caducado. <a href="/login">Inicia sesión de nuevo</a>.</p></section>
}
else if (_error || _profile is null)
{
    <section class="account-panel"><p role="alert">No se ha podido cargar el perfil. Vuelve a intentarlo.</p></section>
}
else
{
    <AccountView Email="@_profile.Email"
                 DisplayName="@(_profile.DisplayName ?? _profile.Email)"
                 Message="@_message" IsError="@_isError" />
}

@code {
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    private bool _loading = true;
    private bool _unauthorized;
    private bool _error;
    private bool _isError;
    private string? _message;
    private ProfilePayload? _profile;

    protected override async Task OnInitializedAsync()
    {
        var state = await Authentication.GetAuthenticationStateAsync();
        var token = state.User.FindFirstValue("api_token");
        if (string.IsNullOrWhiteSpace(token)) { _unauthorized = true; _loading = false; return; }
        try
        {
            using var client = Clients.CreateClient("FacturacionAuthApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            using var response = await client.GetAsync("api/auth/me/profile");
            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                _unauthorized = true;
            else if (!response.IsSuccessStatusCode)
                _error = true;
            else
                _profile = (await response.Content.ReadFromJsonAsync<ProfileEnvelope>())?.Data;
            if (_profile is null && !_unauthorized) _error = true;
        }
        catch (HttpRequestException) { _error = true; }
        catch (System.Text.Json.JsonException) { _error = true; }
        finally { _loading = false; }
    }

    protected override void OnParametersSet()
    {
        _isError = Status is not null and not "ok";
        _message = Status switch
        {
            "mismatch" => "Las nuevas contraseñas no coinciden.",
            "invalid" => "No se ha podido cambiar la contraseña. Revisa la contraseña actual y los requisitos de seguridad.",
            "expired" => "La sesión ha caducado. Vuelve a iniciar sesión.",
            _ => null
        };
    }

    private sealed record ProfileEnvelope(ProfilePayload? Data);
    private sealed record ProfilePayload(string UserId, string Email, string? DisplayName, bool IsActive);
}
