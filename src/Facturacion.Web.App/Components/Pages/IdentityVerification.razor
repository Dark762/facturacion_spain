@page "/identity-verification"
@rendermode InteractiveServer
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider Authentication
@inject IHttpClientFactory Clients

<PageTitle>Verificación de identidad | FacturaciónES</PageTitle>
<section class="verification-page">
    <p class="verification-kicker">SEGURIDAD / IDENTIDAD</p>
    <h1>Verificación de identidad</h1>
    <p>Antes de utilizar operaciones sensibles debemos comprobar quién eres y, si corresponde, tu autorización para representar a una empresa.</p>
    <div class="verification-card">
        <h2>Iniciar una solicitud</h2>
        <p>Elige cómo deseas iniciar la verificación. La solicitud no acredita por sí misma tu identidad.</p>
        <div class="verification-fields">
            <label>Método
                <select @bind="_method" disabled="@_busy">
                    <option value="Manual">Revisión documental</option>
                    <option value="Certificate">Certificado digital</option>
                </select>
            </label>
            <label>Tipo de titular
                <select @bind="_subjectKind" disabled="@_busy">
                    <option value="Individual">Autónomo / persona física</option>
                    <option value="LegalEntity">Sociedad / persona jurídica</option>
                </select>
            </label>
        </div>
        @if (_method == "Certificate")
        {
            <p class="verification-info">La validación técnica del certificado todavía no está habilitada. Esta acción únicamente abre una solicitud; no te identificará automáticamente.</p>
        }
        else
        {
            <p class="verification-info">La recepción segura de documentos está pendiente de integración. No envíes DNI ni documentos personales por correo electrónico.</p>
        }
        <button type="button" disabled="@_busy" @onclick="StartAsync">Crear solicitud</button>
        @if (_message is not null)
        {
            <p role="status" class="@(_error ? "verification-error" : "verification-success")">@_message</p>
        }
    </div>
    <div class="verification-card">
        <h2>Mis solicitudes</h2>
        @if (_loading) { <p>Cargando…</p> }
        else if (_requests.Count == 0) { <p>No tienes solicitudes registradas.</p> }
        else
        {
            <div class="verification-scroll">
                <table>
                    <thead><tr><th>Fecha</th><th>Método</th><th>Titular</th><th>Estado</th></tr></thead>
                    <tbody>
                        @foreach (var item in _requests)
                        {
                            <tr><td>@item.CreatedAt.ToString("dd/MM/yyyy")</td><td>@item.Method</td><td>@item.SubjectKind</td><td><span class="verification-state">@StateLabel(item.Status)</span></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@code {
    private string _method = "Manual";
    private string _subjectKind = "Individual";
    private string? _message;
    private bool _error;
    private bool _busy;
    private bool _loading = true;
    private List<RequestItem> _requests = [];
    private static string StateLabel(string status) => status switch
    {
        "AwaitingEvidence" => "Pendiente de documentación",
        "AwaitingCertificate" => "Pendiente de certificado",
        "UnderReview" => "En revisión",
        "Rejected" => "Rechazada",
        "Verified" => "Verificada",
        _ => status
    };
    protected override async Task OnInitializedAsync() => await RefreshAsync();
    private async Task<HttpClient?> AuthorizedClientAsync()
    {
        var state = await Authentication.GetAuthenticationStateAsync();
        var token = state.User.FindFirstValue(FacturacionClaim.ApiToken.ToClaimType());
        if (string.IsNullOrWhiteSpace(token)) return null;
        var client = Clients.CreateClient("FacturacionAuthApi");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        return client;
    }
    private async Task RefreshAsync()
    {
        _loading = true;
        try
        {
            using var client = await AuthorizedClientAsync();
            if (client is null) { _error = true; _message = "Inicia sesión para consultar tus solicitudes."; return; }
            using var response = await client.GetAsync("api/identity-verification/mine");
            if (!response.IsSuccessStatusCode) { _error = true; _message = "No se pudieron consultar las solicitudes."; return; }
            _requests = (await response.Content.ReadFromJsonAsync<Envelope<List<RequestItem>>>())?.Data ?? [];
        }
        catch (HttpRequestException) { _error = true; _message = "No se pudo contactar con la API."; }
        catch (System.Text.Json.JsonException) { _error = true; _message = "Respuesta inesperada de la API."; }
        finally { _loading = false; }
    }
    private async Task StartAsync()
    {
        if (_busy) return;
        _busy = true; _error = false; _message = null;
        try
        {
            using var client = await AuthorizedClientAsync();
            if (client is null) { _error = true; _message = "Sesión no disponible."; return; }
            using var response = await client.PostAsJsonAsync("api/identity-verification",
                new { Method = _method, SubjectKind = _subjectKind });
            _error = !response.IsSuccessStatusCode;
            _message = _error ? "No se pudo crear la solicitud. Comprueba si ya tienes una solicitud vigente." :
                "Solicitud creada. Pendiente de habilitar la comprobación de identidad.";
            if (!_error) await RefreshAsync();
        }
        catch (HttpRequestException) { _error = true; _message = "No se pudo contactar con la API."; }
        finally { _busy = false; }
    }
    private sealed record Envelope<T>(T? Data);
    private sealed record RequestItem(Guid Id, string Method, string SubjectKind, string Status, DateTimeOffset CreatedAt);
}
