@page "/catalog/{CompanyId:guid}/customers"
@rendermode InteractiveServer
@using Facturacion.Client
@using Microsoft.AspNetCore.Components.Web
@using System.Net.Http.Headers
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider Authentication
@inject IHttpClientFactory Clients

<PageTitle>Clientes | Facturación ES</PageTitle>
<section class="customer-page">
    <div class="customer-page-heading">
        <div>
            @if (ShowHeading) { <h1>Mis clientes</h1> }
            <p class="muted">Gestiona los datos de tus clientes para la facturación.</p>
        </div>
        @if (_api is not null && !_showEditor)
        {
            <button type="button" class="button customer-primary-action" @onclick="StartCreate">+ Añadir cliente</button>
        }
    </div>
    @if (_unauthorized)
    {
        <p class="notice" role="alert">Tu sesión no está disponible. <a href="/login">Inicia sesión</a>.</p>
    }
    else if (_initializing)
    {
        <p class="muted">Cargando sesión…</p>
    }
    else if (_api is null)
    {
        <p class="notice" role="alert">No se pudo conectar el catálogo de clientes.</p>
    }
    else
    {
        <div class="customer-list-card">
            <div class="customer-filters">
                <div class="customer-search-field">
                    <label for="customer-search">Buscar clientes</label>
                    <input id="customer-search" type="search" placeholder="Nombre, razón social o NIF" @bind="_search" @bind:event="oninput" @onkeydown="SearchOnEnterAsync" maxlength="120" />
                </div>
                <button type="button" class="button customer-search-button" disabled="@_loading" @onclick="SearchAsync">Buscar</button>
                <button type="button" class="button button-outline customer-clear-button" disabled="@_loading" @onclick="ClearSearchAsync">Limpiar filtros</button>
            </div>
            @if (_error is not null) { <p class="customer-error" role="alert">@_error</p> }
            @if (_loading && _customers is null)
            {
                <p class="muted customer-loading">Cargando clientes…</p>
            }
            else if (!_loading && _customers is { Count: 0 })
            {
                <div class="customer-empty">
                    <div class="customer-empty-icon" aria-hidden="true">◎</div>
                    <h2>@(string.IsNullOrWhiteSpace(_appliedSearch) ? "Todavía no tienes clientes" : "No encontramos clientes")</h2>
                    <p class="muted">@(string.IsNullOrWhiteSpace(_appliedSearch) ? "Añade tu primer cliente para comenzar a gestionar tus contactos de facturación." : "Prueba con otro nombre o NIF, o limpia los filtros para ver todos los clientes.")</p>
                    @if (string.IsNullOrWhiteSpace(_appliedSearch))
                    {
                        <button type="button" class="button" @onclick="StartCreate">Añadir primer cliente</button>
                    }
                    else
                    {
                        <button type="button" class="button button-outline" @onclick="ClearSearchAsync">Limpiar búsqueda</button>
                    }
                </div>
            }
            else
            {
                <div class="customer-table-wrap">
                    <CustomersTable Customers="_customers" OnEdit="Edit" OnDelete="DeleteAsync" />
                </div>
                @if (_totalPages > 1 || _hasNext)
                {
                    <nav class="customer-pagination" aria-label="Paginación de clientes">
                        <span>Página @_page de @_totalPages · @_totalCount clientes</span>
                        <div class="customer-pagination-buttons">
                            <button type="button" class="button button-outline" disabled="@(_page <= 1 || _loading)" @onclick="PreviousAsync">Anterior</button>
                            <button type="button" class="button button-outline" disabled="@(!_hasNext || _loading)" @onclick="NextAsync">Siguiente</button>
                        </div>
                    </nav>
                }
            }
        </div>
        @if (_showEditor)
        {
            <section class="customer-editor-card">
                <h2>@(_editingId is null ? "Nuevo cliente" : "Editar cliente")</h2>
                <CustomerEditor @key="_editor" Model="_editor" Saving="_saving" OnSave="SaveAsync" />
                <button type="button" class="button button-outline" @onclick="CancelEdit">Cancelar</button>
            </section>
        }
    }
</section>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public bool ShowHeading { get; set; } = true;
    private bool _showEditor;
    private CustomersApiClient? _api;
    private HttpClient? _http;
    private bool _unauthorized;
    private bool _initializing = true;
    private IReadOnlyList<CustomerDto>? _customers;
    private CustomerEditModel _editor = new();
    private Guid? _editingId;
    private bool _saving;
    private string? _error;
    private string _search = "";
    private string _appliedSearch = "";
    private int _page = 1;
    private const int PageSize = 20;
    private bool _hasNext;
    private int _totalCount;
    private int _totalPages = 1;
    private bool _loading;

    private async Task SearchAsync() { _page = 1; _appliedSearch = _search.Trim(); await LoadAsync(); }
    private async Task ClearSearchAsync() { _search = ""; _appliedSearch = ""; _page = 1; await LoadAsync(); }
    private async Task SearchOnEnterAsync(KeyboardEventArgs args) { if (args.Key == "Enter") await SearchAsync(); }
    private async Task PreviousAsync() { if (_page > 1) { _page--; await LoadAsync(); } }
    private async Task NextAsync() { if (_hasNext) { _page++; await LoadAsync(); } }

    protected override async Task OnInitializedAsync()
    {
        var state = await Authentication.GetAuthenticationStateAsync();
        var token = state.User.FindFirstValue("api_token");
        var selectedTenant = state.User.FindFirstValue("tenant_id");
        if (state.User.Identity?.IsAuthenticated != true || string.IsNullOrWhiteSpace(token) ||
            !Guid.TryParse(selectedTenant, out _))
        {
            _unauthorized = true;
            _initializing = false;
            return;
        }
        _http = Clients.CreateClient("FacturacionAuthApi");
        _http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        _api = new CustomersApiClient(new ApiClient(_http));
        _initializing = false;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_api is null) return;
        if (_loading) return;
        _loading = true;
        try
        {
            var result = await _api.SearchAsync(CompanyId, _appliedSearch, _page, PageSize);
            if (result.IsSuccess)
            {
                _customers = result.Value;
                _totalCount = result.TotalCount ?? (_page - 1) * PageSize + (_customers?.Count ?? 0);
                _totalPages = Math.Max(1, (int)Math.Ceiling((double)_totalCount / PageSize));
                _hasNext = result.TotalCount.HasValue
                    ? _page < _totalPages
                    : (_customers?.Count ?? 0) == PageSize;
            }
            _error = result.Error?.Message;
        }
        catch (HttpRequestException) { _error = "No se pudo contactar con la API."; }
        finally { _loading = false; }
    }

    private void Edit(CustomerDto customer)
    {
        _showEditor = true;
        _editingId = customer.Id;
        _editor = CustomerEditModel.From(customer);
    }

    private void StartCreate() { _editingId = null; _editor = new(); _showEditor = true; }
    private void CancelEdit() { _editingId = null; _editor = new(); _showEditor = false; }

    private async Task SaveAsync(SaveCustomerDto input)
    {
        if (_api is null || _saving) return;
        _saving = true;
        try
        {
            var result = _editingId is Guid id
                ? await _api.UpdateAsync(CompanyId, id, input)
                : await _api.CreateAsync(CompanyId, input);
            _error = result.Error?.Message;
            if (result.IsSuccess) { CancelEdit(); await LoadAsync(); }
        }
        catch (HttpRequestException) { _error = "No se pudo contactar con la API."; }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(Guid id)
    {
        if (_api is null) return;
        try
        {
            var result = await _api.DeleteAsync(CompanyId, id);
            _error = result.Error?.Message;
            if (result.IsSuccess) await LoadAsync();
        }
        catch (HttpRequestException) { _error = "No se pudo contactar con la API."; }
    }
}
