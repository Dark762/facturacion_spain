@page "/catalog/{CompanyId:guid}/customers"
@rendermode InteractiveServer
@using Facturacion.Client
@using Microsoft.AspNetCore.Components.Web
@using System.Net.Http.Headers
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider Authentication
@inject IHttpClientFactory Clients

<PageTitle>Clientes | Facturación ES</PageTitle>
<section class="customer-page">
    <div class="customer-page-heading">
        <div>
            @if (ShowHeading) { <h1>Mis clientes</h1> }

        </div>
        @if (_api is not null)
        {
            <button type="button" class="button customer-primary-action" @onclick="StartCreate">+ Añadir cliente</button>
        }
    </div>
    <nav class="customer-view-tabs" aria-label="Vista del catálogo">
        <span class="customer-view-tab-active" aria-current="page">Directorio de clientes</span>
    </nav>
    @if (_api is not null && _customers is not null && string.IsNullOrWhiteSpace(_appliedSearch))
    {
        <div class="customer-overview">
            <div class="customer-overview-card">
                <span class="customer-overview-label">Total de clientes</span>
                <strong>@_totalCount.ToString("N0")</strong>
                <span class="customer-overview-caption">Registrados en esta actividad</span>
            </div>
        </div>
    }
    @if (_unauthorized)
    {
        <p class="notice" role="alert">Tu sesión no está disponible. <a href="/login">Inicia sesión</a>.</p>
    }
    else if (_initializing)
    {
        <p class="muted">Cargando sesión…</p>
    }
    else if (_api is null)
    {
        <p class="notice" role="alert">No se pudo conectar el catálogo de clientes.</p>
    }
    else
    {
        <div class="customer-list-card">
            <div class="customer-directory-heading">
                <div>
                    <h2>Todos los clientes</h2>
                    <p class="muted">@(string.IsNullOrWhiteSpace(_appliedSearch) ? "Todos tus clientes" : "Resultados de la búsqueda")</p>
                </div>
                @if (_customers is not null && !_loading)
                {
                    <span class="customer-count">@_totalCount @( _totalCount == 1 ? "cliente" : "clientes")</span>
                }
            </div>
            <div class="customer-filters">
                <div class="customer-search-field">
                    <span class="customer-search-glyph" aria-hidden="true">⌕</span>
                    <label class="customer-visually-hidden" for="customer-search">Buscar clientes</label>
                    <input id="customer-search" type="search" placeholder="Buscar por nombre o NIF..." @bind="_search" @bind:event="oninput" @onkeydown="SearchOnEnterAsync" maxlength="120" />
                </div>
                <button type="button" class="button customer-search-button" disabled="@_loading" @onclick="SearchAsync">Buscar</button>
                <button type="button" class="button button-outline customer-clear-button" disabled="@_loading" @onclick="ClearSearchAsync">Limpiar</button>
            </div>
            @if (_error is not null) { <p class="customer-error" role="alert">@_error</p> }
            @if (_loading && _customers is null)
            {
                <p class="muted customer-loading">Cargando clientes…</p>
            }
            else if (!_loading && _customers is { Count: 0 })
            {
                <div class="customer-empty">
                    <div class="customer-empty-icon" aria-hidden="true">◎</div>
                    <h2>@(string.IsNullOrWhiteSpace(_appliedSearch) ? "Todavía no tienes clientes" : "No encontramos clientes")</h2>
                    <p class="muted">@(string.IsNullOrWhiteSpace(_appliedSearch) ? "Añade tu primer cliente para comenzar a gestionar tus contactos de facturación." : "Prueba con otro nombre o NIF, o limpia los filtros para ver todos los clientes.")</p>
                    @if (string.IsNullOrWhiteSpace(_appliedSearch))
                    {
                        <button type="button" class="button" @onclick="StartCreate">Añadir primer cliente</button>
                    }
                    else
                    {
                        <button type="button" class="button button-outline" @onclick="ClearSearchAsync">Limpiar búsqueda</button>
                    }
                </div>
            }
            else
            {
                <div class="customer-table-wrap">
                    <CustomersTable Customers="_customers" OnEdit="Edit" OnDelete="RequestDelete" />
                </div>
                @if (_totalPages > 1 || _hasNext)
                {
                    <nav class="customer-pagination" aria-label="Paginación de clientes">
                        <span class="customer-pagination-status">Página @_page de @_totalPages</span>
                        <div class="customer-pagination-buttons">
                            <button type="button" class="button button-outline" disabled="@(_page <= 1 || _loading)" @onclick="PreviousAsync">Anterior</button>
                            <button type="button" class="button button-outline" disabled="@(!_hasNext || _loading)" @onclick="NextAsync">Siguiente</button>
                        </div>
                    </nav>
                }
            }
        </div>
        @if (_pendingDelete is not null)
        {
            <div class="customer-confirm-backdrop" aria-hidden="true"></div>
            <section class="customer-confirm-dialog" role="alertdialog" aria-modal="true" aria-labelledby="customer-confirm-title" aria-describedby="customer-confirm-description">
                <div class="customer-confirm-icon" aria-hidden="true">!</div>
                <h2 id="customer-confirm-title">¿Eliminar cliente?</h2>
                <p id="customer-confirm-description">Se eliminará a <strong>@_pendingDelete.LegalName</strong> del catálogo. Esta acción no se puede deshacer.</p>
                <div class="customer-confirm-actions">
                    <button type="button" class="button button-outline" disabled="@_deleting" @onclick="CancelDelete">Cancelar</button>
                    <button type="button" class="button customer-danger-action" disabled="@_deleting" @onclick="ConfirmDeleteAsync">@(_deleting ? "Eliminando…" : "Sí, eliminar")</button>
                </div>
            </section>
        }
        @if (_showEditor)
        {
            <div class="customer-editor-backdrop" aria-hidden="true"></div>
            <section class="customer-editor-dialog" role="dialog" aria-modal="true" aria-labelledby="customer-editor-title">
                <div class="customer-editor-header">
                    <div>
                        <h2 id="customer-editor-title">@(_editingId is null ? "Añadir cliente" : "Editar cliente")</h2>
                        <p>Completa los datos de facturación del cliente.</p>
                    </div>
                    <button type="button" class="customer-editor-close" aria-label="Cerrar formulario" disabled="@_saving" @onclick="CancelEdit">×</button>
                </div>
                @if (_editorError is not null)
                {
                    <p class="customer-error" role="alert">@_editorError</p>
                }
                <CustomerEditor @key="_editor" Model="_editor" Saving="_saving" OnSave="SaveAsync" OnCancel="CancelEdit" />
            </section>
        }
    }
</section>

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public bool ShowHeading { get; set; } = true;
    private bool _showEditor;
    private CustomersApiClient? _api;
    private HttpClient? _http;
    private bool _unauthorized;
    private bool _initializing = true;
    private IReadOnlyList<CustomerDto>? _customers;
    private CustomerEditModel _editor = new();
    private Guid? _editingId;
    private bool _saving;
    private string? _error;
    private string? _editorError;
    private string _search = "";
    private string _appliedSearch = "";
    private int _page = 1;
    private const int PageSize = 20;
    private bool _hasNext;
    private int _totalCount;
    private int _totalPages = 1;
    private bool _loading;
    private CustomerDto? _pendingDelete;
    private bool _deleting;

    private async Task SearchAsync() { _page = 1; _appliedSearch = _search.Trim(); await LoadAsync(); }
    private async Task ClearSearchAsync() { _search = ""; _appliedSearch = ""; _page = 1; await LoadAsync(); }
    private async Task SearchOnEnterAsync(KeyboardEventArgs args) { if (args.Key == "Enter") await SearchAsync(); }
    private async Task PreviousAsync() { if (_page > 1) { _page--; await LoadAsync(); } }
    private async Task NextAsync() { if (_hasNext) { _page++; await LoadAsync(); } }

    protected override async Task OnInitializedAsync()
    {
        var state = await Authentication.GetAuthenticationStateAsync();
        var token = state.User.FindFirstValue("api_token");
        var selectedTenant = state.User.FindFirstValue("tenant_id");
        if (state.User.Identity?.IsAuthenticated != true || string.IsNullOrWhiteSpace(token) ||
            !Guid.TryParse(selectedTenant, out _))
        {
            _unauthorized = true;
            _initializing = false;
            return;
        }
        _http = Clients.CreateClient("FacturacionAuthApi");
        _http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        _api = new CustomersApiClient(new ApiClient(_http));
        _initializing = false;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_api is null) return;
        if (_loading) return;
        _loading = true;
        try
        {
            var result = await _api.SearchAsync(CompanyId, _appliedSearch, _page, PageSize);
            if (result.IsSuccess)
            {
                _customers = result.Value;
                _totalCount = result.TotalCount ?? (_page - 1) * PageSize + (_customers?.Count ?? 0);
                _totalPages = Math.Max(1, (int)Math.Ceiling((double)_totalCount / PageSize));
                _hasNext = result.TotalCount.HasValue
                    ? _page < _totalPages
                    : (_customers?.Count ?? 0) == PageSize;
            }
            _error = result.Error?.Message;
        }
        catch (HttpRequestException) { _error = "No se pudo contactar con la API."; }
        finally { _loading = false; }
    }

    private void Edit(CustomerDto customer)
    {
        _editorError = null;
        _showEditor = true;
        _editingId = customer.Id;
        _editor = CustomerEditModel.From(customer);
    }

    private void StartCreate() { if (_saving) return; _editorError = null; _editingId = null; _editor = new() { CountryCode = "ES" }; _showEditor = true; }
    private void CancelEdit() { if (_saving) return; _editorError = null; _editingId = null; _editor = new(); _showEditor = false; }

    private async Task SaveAsync(SaveCustomerDto input)
    {
        if (_api is null || _saving) return;
        _editorError = null;
        _saving = true;
        try
        {
            var result = _editingId is Guid id
                ? await _api.UpdateAsync(CompanyId, id, input)
                : await _api.CreateAsync(CompanyId, input);
            if (result.IsSuccess)
            {
                _saving = false;
                CancelEdit();
                await LoadAsync();
            }
            else
            {
                _editorError = result.Error?.Code switch
                {
                    "CUSTOMER_TAX_ID_DUPLICATE" => "Ya existe un cliente con ese NIF, NIE o CIF en esta empresa.",
                    "CUSTOMER_INVALID" => "Revisa el NIF, NIE o CIF y los datos del cliente. El identificador fiscal debe ser válido para España.",
                    _ => result.Error?.Message ?? "No se pudo guardar el cliente."
                };
            }
        }
        catch (HttpRequestException) { _editorError = "No se pudo contactar con la API. Inténtalo de nuevo."; }
        finally { _saving = false; }
    }

    private void RequestDelete(Guid id)
    {
        _pendingDelete = _customers?.FirstOrDefault(customer => customer.Id == id);
    }

    private void CancelDelete() { if (!_deleting) _pendingDelete = null; }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDelete is null || _deleting) return;
        _deleting = true;
        try { await DeleteAsync(_pendingDelete.Id); }
        finally { _deleting = false; }
    }

    private async Task DeleteAsync(Guid id)
    {
        if (_api is null) return;
        try
        {
            var result = await _api.DeleteAsync(CompanyId, id);
            _error = result.Error?.Message;
            if (result.IsSuccess)
            {
                _pendingDelete = null;
                await LoadAsync();
                if (_customers is { Count: 0 } && _page > 1)
                {
                    _page--;
                    await LoadAsync();
                }
            }
        }
        catch (HttpRequestException) { _error = "No se pudo contactar con la API."; }
    }
}
