@page "/platform"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Security.Claims
@inject IHttpClientFactory Clients
@inject IHttpContextAccessor HttpAccessor

<PageTitle>Centro de Control | FacturaciónES</PageTitle>
<div class="platform-dashboard">
    <header class="platform-hero">
        <div>
            <p class="platform-eyebrow">ADMINISTRACIÓN GENERAL / RESUMEN</p>
            <h1>Centro de Control</h1>
            <p class="platform-description">Supervisa las organizaciones, suscripciones y actividad de tu plataforma desde un solo lugar.</p>
        </div>
        <a class="platform-action" href="/platform/incidents">Ver incidencias <span aria-hidden="true">↗</span></a>
    </header>

    @if (_forbidden)
    {
        <div class="platform-message" role="alert">No tienes permisos de administrador de plataforma.</div>
    }
    else if (_error)
    {
        <div class="platform-message" role="alert">No se han podido cargar los datos. Comprueba la conexión con la API.</div>
    }
    else if (_summary is null)
    {
        <p role="status">Cargando información de la plataforma…</p>
    }
    else
    {
        <section aria-label="Indicadores principales" class="platform-metrics">
            <article class="platform-metric">
                <span class="platform-metric-label">Organizaciones registradas</span>
                <strong>@_summary.TotalTenants</strong>
                <span class="platform-metric-foot">Total de tenants</span>
            </article>
            <article class="platform-metric">
                <span class="platform-metric-label">Organizaciones activas</span>
                <strong>@_summary.ActiveTenants</strong>
                <span class="platform-metric-foot"><span class="platform-dot"></span> Actualmente activas</span>
            </article>
            <article class="platform-metric">
                <span class="platform-metric-label">Empresas activas</span>
                <strong>@_summary.ActiveCompanies</strong>
                <span class="platform-metric-foot">En toda la plataforma</span>
            </article>
        </section>
        <section class="platform-panel" aria-labelledby="platform-tenants-title">
            <div class="platform-panel-header">
                <div>
                    <h2 id="platform-tenants-title">Organizaciones</h2>
                    <p>Listado de tenants y estado de sus suscripciones</p>
                </div>
                <span class="platform-count">@_tenants.Length en esta página</span>
            </div>
            <div class="platform-table-scroll">
                <table class="platform-table">
                    <thead><tr><th>Organización</th><th>Estado</th><th>Empresas</th><th>Plan</th><th>Suscripción</th><th>Fecha de alta</th></tr></thead>
                    <tbody>
                        @foreach (var tenant in _tenants)
                        {
                            <tr>
                                <td><span class="platform-tenant-avatar">@(string.IsNullOrWhiteSpace(tenant.Name) ? "?" : tenant.Name[..1].ToUpperInvariant())</span><strong>@tenant.Name</strong></td>
                                <td><span class="platform-status @(tenant.IsActive ? "platform-status-active" : "platform-status-inactive")">@(tenant.IsActive ? "Activo" : "Inactivo")</span></td>
                                <td>@tenant.ActiveCompanies</td>
                                <td><span class="platform-plan">@(tenant.PlanCode ?? "Sin plan")</span></td>
                                <td>@(tenant.SubscriptionStatus ?? "—")</td>
                                <td>@(tenant.RegisteredAt?.ToString("dd/MM/yyyy") ?? "—")</td>
                            </tr>
                        }
                        @if (_tenants.Length == 0)
                        {
                            <tr><td colspan="6" class="platform-empty">No hay organizaciones para mostrar.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <footer class="platform-pagination">
                <span>Página @_page</span>
                <div>
                    @if (_page > 1)
                    {
                        <a href="@($"/platform?page={_page - 1}")">← Anterior</a>
                    }
                    @if (_tenants.Length == 25)
                    {
                        <a href="@($"/platform?page={_page + 1}")">Siguiente →</a>
                    }
                </div>
            </footer>
        </section>
    }
</div>
@code {
    [SupplyParameterFromQuery(Name = "page")] public int? Page { get; set; }
    private int _page = 1;
    private bool _forbidden;
    private bool _error;
    private PlatformSummary? _summary;
    private TenantOverview[] _tenants = [];

    protected override async Task OnParametersSetAsync()
    {
        _page = Math.Clamp(Page ?? 1, 1, 100000);
        var token = HttpAccessor.HttpContext?.User.FindFirstValue(FacturacionClaim.ApiToken.ToClaimType());
        if (string.IsNullOrEmpty(token)) { _forbidden = true; return; }
        try
        {
            using var client = Clients.CreateClient("FacturacionAuthApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            using var summaryResponse = await client.GetAsync("api/platform/summary");
            using var tenantsResponse = await client.GetAsync($"api/platform/tenants?page={_page}&pageSize=25");
            if (summaryResponse.StatusCode is System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized ||
                tenantsResponse.StatusCode is System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Unauthorized)
            { _forbidden = true; return; }
            if (!summaryResponse.IsSuccessStatusCode || !tenantsResponse.IsSuccessStatusCode)
            { _error = true; return; }
            _summary = (await summaryResponse.Content.ReadFromJsonAsync<Envelope<PlatformSummary>>())?.Data;
            _tenants = (await tenantsResponse.Content.ReadFromJsonAsync<Envelope<TenantOverview[]>>())?.Data ?? [];
            if (_summary is null) _error = true;
        }
        catch (HttpRequestException) { _error = true; }
        catch (System.Text.Json.JsonException) { _error = true; }
    }

    private sealed record Envelope<T>(T? Data);
    private sealed record PlatformSummary(int TotalTenants, int ActiveTenants, int ActiveCompanies);
    private sealed record TenantOverview(Guid TenantId, string Name, bool IsActive, int ActiveCompanies,
        string? PlanCode, string? SubscriptionStatus, DateTimeOffset? RegisteredAt);
}
