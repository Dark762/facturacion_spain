@page "/registro"
@using Facturacion.Web.Public.Services
@using Microsoft.AspNetCore.Components.Forms
@using Facturacion.Application.Billing
@using Facturacion.Application.Common.Results
@using Facturacion.Application.Interfaces
@using Facturacion.Configuration.Options
@using Microsoft.Extensions.Options

@inject ISaaSRegistrationApplicationService Registration
@inject PublicPlansService Plans
@inject IOptions<StripeOptions> Stripe
@inject IOptions<EmailOptions> Email
@inject NavigationManager Navigation

<PageTitle>Registro | Facturación ES</PageTitle>

<section class="container section registration-page">
    <span class="eyebrow">Crear cuenta</span>
    <h1>Empieza con tu organización</h1>
    <div class="card registration-card">
        @if (!Email.Value.IsConfigured || string.IsNullOrWhiteSpace(Email.Value.Smtp.Host) || !Stripe.Value.IsConfigured)
        {
            <div class="notice" role="status">El alta online todavía no está disponible: es necesario configurar el envío de correo y Stripe. No se crearán cuentas incompletas.</div>
        }
        else if (_step == RegistrationStep.Account)
        {
            <h2>1. Crea tu cuenta</h2>
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="notice registration-error-banner" role="alert">@_error</div>
            }
            <EditForm EditContext="_formEditContext" OnValidSubmit="RegisterAsync" FormName="saas-register">
                <DataAnnotationsValidator />
                <div class="registration-group-title">Datos de acceso</div>
                <div class="registration-fields registration-fields-access">
                    <label>Nombre completo <InputText @bind-Value="_form.DisplayName" /><ValidationMessage For="@(() => _form.DisplayName)" /></label>
                    <label>Correo electrónico <InputText type="email" @bind-Value="_form.Email" /><ValidationMessage For="@(() => _form.Email)" /></label>
                    <label>Contraseña <InputText type="password" autocomplete="new-password" @bind-Value="_form.Password" /><ValidationMessage For="@(() => _form.Password)" /></label>
                </div>
                <p class="muted">Se enviará un correo de verificación. No se realizará ningún cobro en este paso.</p>
                <button class="button" type="submit" disabled="@_busy">Continuar</button>
            </EditForm>
        }
        else if (_step == RegistrationStep.EmailVerification)
        {
            <h2>2. Verifica tu correo</h2>
            <p>Revisa el mensaje enviado a @_form.Email e introduce el código de 6 dígitos. Caduca en pocos minutos.</p>
            <label class="registration-code-label">Código de verificación <input class="registration-code-input" @bind="_verificationToken" inputmode="numeric" pattern="@RegistrationRules.VerificationCodePattern" maxlength="@RegistrationRules.VerificationCodeLength" autocomplete="one-time-code" placeholder="000000" aria-describedby="verification-help" /></label>
            <p id="verification-help" class="muted">Consulta el correo más reciente y no compartas este código.</p>
            <p><button class="button" disabled="@_busy" @onclick="VerifyAsync">Verificar correo</button></p>
        }
        else if (_step == RegistrationStep.CompanyDetails)
        {
            <h2>3. Configura tu empresa</h2>
            <p class="muted">Necesitamos estos datos fiscales antes de contratar un plan y emitir facturas.</p>
            <EditForm EditContext="_companyEditContext" OnValidSubmit="CompleteCompanyAsync" FormName="saas-company">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="registration-group-title">Tipo de titular fiscal</div>
                <div class="registration-holder-types">
                    <InputRadioGroup @bind-Value="_company.HolderType">
                        <label><InputRadio Value="@(FiscalHolderType.Individual.ToStorageValue())" /> Persona física (autónomo o profesional)</label>
                        <label><InputRadio Value="@(FiscalHolderType.LegalEntity.ToStorageValue())" /> Persona jurídica (sociedad o entidad)</label>
                    </InputRadioGroup>
                    <ValidationMessage For="@(() => _company.HolderType)" />
                </div>
                <div class="registration-group-title">Datos fiscales</div>
                <div class="registration-fields registration-fields-company">
                    <label>@(_company.HolderType.Is(FiscalHolderType.Individual) ? "Nombre y apellidos" : "Razón social") <InputText @bind-Value="_company.LegalName" /><ValidationMessage For="@(() => _company.LegalName)" /></label>
                    <label>@(_company.HolderType.Is(FiscalHolderType.Individual) ? "NIF o NIE" : "NIF de la entidad") <InputText @bind-Value="_company.Nif" /><ValidationMessage For="@(() => _company.Nif)" /></label>
                    <label>Nombre comercial (opcional) <InputText @bind-Value="_company.TradeName" /></label>
                    <label>Dirección <InputText @bind-Value="_company.Address" /><ValidationMessage For="@(() => _company.Address)" /></label>
                    <label>Código postal <InputText @bind-Value="_company.PostalCode" /><ValidationMessage For="@(() => _company.PostalCode)" /></label>
                    <label>Ciudad <InputText @bind-Value="_company.City" /><ValidationMessage For="@(() => _company.City)" /></label>
                    <label>Provincia <InputText @bind-Value="_company.Province" /><ValidationMessage For="@(() => _company.Province)" /></label>
                </div>
                <button class="button" type="submit" disabled="@_busy">Guardar y elegir plan</button>
            </EditForm>
        }
        else if (_step == RegistrationStep.PlanSelection)
        {
            <h2>4. Selecciona un plan</h2>
            <p class="muted registration-plan-intro">Elige el plan que mejor se adapte a tu organización. Podrás revisar los detalles antes de confirmar.</p>
            @if (_plans.Count == 0)
            {
                <p role="status">No hay planes activos configurados para contratación.</p>
            }
            else
            {
                <div class="registration-plan-grid" role="radiogroup" aria-label="Selecciona un plan">
                    @foreach (var plan in _plans)
                    {
                        var selected = _selectedPlan == plan.Code;
                        <label class="registration-plan-card @(selected ? "is-selected" : "")">
                            <input type="radio" name="registration-plan" value="@plan.Code" checked="@selected" @onchange="() => _selectedPlan = plan.Code" />
                            <span class="registration-plan-card-top">
                                <strong>@plan.Name</strong>
                                @if (selected)
                                {
                                    <span class="registration-plan-selected">Seleccionado</span>
                                }
                            </span>
                            <span class="registration-plan-price">@plan.MonthlyPrice.ToString("N2", new System.Globalization.CultureInfo("es-ES")) @plan.Currency <small>/ mes</small></span>
                            @if (!string.IsNullOrWhiteSpace(plan.Description))
                            {
                                <span class="registration-plan-description">@plan.Description</span>
                            }
                            <span class="registration-plan-features">
                                <span>✓ Hasta @plan.MaxCompanies empresas</span>
                                <span>✓ Hasta @plan.MaxUsers usuarios</span>
                                <span>✓ Hasta @plan.MaxInvoicesPerMonth facturas al mes</span>
                            </span>
                        </label>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="notice registration-error-banner" role="alert">@_error</div>
                }
                <div class="registration-plan-footer">
                    <p class="muted">Los importes definitivos y los impuestos se mostrarán en Stripe antes de confirmar la contratación.</p>
                    <button class="button button-large" disabled="@(_busy || string.IsNullOrWhiteSpace(_selectedPlan))" @onclick="CheckoutAsync">Continuar con el plan seleccionado</button>
                    <span class="muted registration-plan-secure">Contratación segura · Revisa el importe antes de confirmar</span>
                </div>
            }
        }
        @if (_step != RegistrationStep.Account && _step != RegistrationStep.PlanSelection && !string.IsNullOrEmpty(_error))
        {
            <div class="notice" role="alert">@_error</div>
        }
    </div>
</section>
@code {
    private sealed class RegistrationForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El campo correo electrónico es obligatorio.")]
        [System.ComponentModel.DataAnnotations.EmailAddress] public string Email { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El campo contraseña es obligatorio.")]
        [System.ComponentModel.DataAnnotations.MinLength(RegistrationRules.MinimumPasswordLength, ErrorMessage = "La contraseña debe tener al menos 12 caracteres.")] public string Password { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El campo nombre completo es obligatorio.")] public string DisplayName { get; set; } = "";
    }
    private sealed class CompanyForm
    {
        [System.ComponentModel.DataAnnotations.Required] public string HolderType { get; set; } = FiscalHolderType.Individual.ToStorageValue();
        public string TradeName { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El campo NIF es obligatorio.")]
        [System.ComponentModel.DataAnnotations.RegularExpression(@"^[A-Za-z0-9]{8,9}$", ErrorMessage = "Introduce un NIF o CIF con formato válido.")] public string Nif { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El campo razón social es obligatorio.")] public string LegalName { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El campo dirección es obligatorio.")] public string Address { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El campo código postal es obligatorio.")]
        [System.ComponentModel.DataAnnotations.RegularExpression(@"^\d{5}$", ErrorMessage = "El código postal debe contener 5 dígitos.")] public string PostalCode { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El campo ciudad es obligatorio.")] public string City { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El campo provincia es obligatorio.")] public string Province { get; set; } = "";
    }
    private readonly RegistrationForm _form = new();
    private readonly CompanyForm _company = new();
    private EditContext _formEditContext = default!;
    private ValidationMessageStore _formServerErrors = default!;
    private EditContext _companyEditContext = default!;
    private ValidationMessageStore _companyServerErrors = default!;
    private RegistrationStep _step;
    private bool _busy;
    private string? _error;
    private Guid _registrationId;
    private string _verificationToken = "";
    private string _checkoutToken = "";
    private string _selectedPlan = "";
    private List<PlanResponse> _plans = new();

    protected override void OnInitialized()
    {
        _formEditContext = new EditContext(_form);
        _formServerErrors = new ValidationMessageStore(_formEditContext);
        _formEditContext.OnFieldChanged += (_, args) =>
        {
            _error = null;
            // Un error global del servidor ("request") no pertenece a ningún campo.
            // Si permanece en el ValidationMessageStore, OnValidSubmit deja de
            // ejecutarse incluso después de corregir el formulario.
            _formServerErrors.Clear();
            _formEditContext.NotifyValidationStateChanged();
        };

        _companyEditContext = new EditContext(_company);
        _companyServerErrors = new ValidationMessageStore(_companyEditContext);
        _companyEditContext.OnFieldChanged += (_, args) =>
        {
            _companyServerErrors.Clear();
            _companyEditContext.NotifyValidationStateChanged();
        };
    }

    private async Task RegisterAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        _formServerErrors.Clear();
        _formEditContext.NotifyValidationStateChanged();
        try
        {
            var result = await Registration.RegisterAsync(new RegisterSaasRequest(
                _form.Email, _form.Password, _form.DisplayName), CancellationToken.None);
            if (result.IsFailure)
            {
                foreach (var err in result.Errors)
                {
                    if (err.Field is "Password")
                        _formServerErrors.Add(new FieldIdentifier(_form, nameof(_form.Password)), err.Message);
                    else
                        _error = err.Message;
                }
                _formEditContext.NotifyValidationStateChanged();
                return;
            }
            _registrationId = result.Value.RegistrationId;
            _form.Password = "";
            _step = RegistrationStep.EmailVerification;
        }
        catch (Exception)
        {
            _error = "No se ha podido iniciar el registro. Comprueba los datos o contacta con soporte.";
        }
        finally { _busy = false; }
    }

    private async Task VerifyAsync()
    {
        if (_busy) return;
        if (_verificationToken.Length != RegistrationRules.VerificationCodeLength || !_verificationToken.All(char.IsAsciiDigit))
        {
            _error = "Introduce un código de 6 dígitos.";
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            var result = await Registration.VerifyEmailAsync(_registrationId, _verificationToken.Trim(), CancellationToken.None);
            if (result.IsFailure)
            {
                _error = result.Errors.FirstOrDefault()?.Message ?? "No se pudo verificar el correo.";
                return;
            }
            _checkoutToken = result.Value;
            _verificationToken = "";
            _plans = await Plans.GetActiveAsync();
            _selectedPlan = _plans.FirstOrDefault()?.Code ?? "";
            _step = RegistrationStep.CompanyDetails;
        }
        catch (Exception) { _error = "No se pudo verificar el correo. Comprueba el código recibido."; }
        finally { _busy = false; }
    }

    private async Task CompleteCompanyAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        _companyServerErrors.Clear();
        _companyEditContext.NotifyValidationStateChanged();
        try
        {
            var result = await Registration.CompleteCompanyAsync(_registrationId, _checkoutToken,
                new CompleteCompanyRequest(_company.LegalName, _company.Nif, _company.Address,
                    _company.PostalCode, _company.City, _company.Province, _company.HolderType, _company.TradeName), CancellationToken.None);
            if (result.IsFailure)
            {
                foreach (var err in result.Errors)
                {
                    var field = err.Field;
                    if (field is nameof(CompanyForm.Nif) or nameof(CompanyForm.LegalName) or nameof(CompanyForm.Address) or nameof(CompanyForm.PostalCode) or nameof(CompanyForm.City) or nameof(CompanyForm.Province) or nameof(CompanyForm.HolderType) or nameof(CompanyForm.TradeName))
                        _companyServerErrors.Add(new FieldIdentifier(_company, field), err.Message);
                    else
                        _error = err.Message;
                }
                _companyEditContext.NotifyValidationStateChanged();
                return;
            }
            _plans = await Plans.GetActiveAsync();
            _selectedPlan = _plans.FirstOrDefault()?.Code ?? "";
            _step = RegistrationStep.PlanSelection;
        }
        catch (Exception)
        {
            _error = "No se han podido guardar los datos de la empresa. Inténtalo de nuevo.";
        }
        finally { _busy = false; }
    }

    private async Task CheckoutAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_selectedPlan) || string.IsNullOrEmpty(_checkoutToken)) return;
        _busy = true;
        _error = null;
        try
        {
            var result = await Registration.CheckoutAsync(_registrationId, _checkoutToken, _selectedPlan, CancellationToken.None);
            if (result.IsFailure)
            {
                _error = result.Errors.FirstOrDefault()?.Message ?? "No se ha podido abrir el pago seguro.";
                return;
            }
            var response = result.Value;
            if (!Uri.TryCreate(response.Url, UriKind.Absolute, out var destination) ||
                destination.Scheme != Uri.UriSchemeHttps ||
                !(destination.Host.Equals("checkout.stripe.com", StringComparison.OrdinalIgnoreCase) ||
                  destination.Host.EndsWith(".checkout.stripe.com", StringComparison.OrdinalIgnoreCase)))
                throw new InvalidOperationException("Destino de pago no válido.");
            Navigation.NavigateTo(destination.ToString(), forceLoad: true);
        }
        catch (Exception) { _error = "No se ha podido abrir el pago seguro. Inténtalo más tarde."; }
        finally { _busy = false; }
    }
}
