@page "/precios"
@using Facturacion.Application.Billing
@using Facturacion.Web.Public.Services
@inject PublicPlansService PlansService
<PageTitle>Planes | Facturación ES</PageTitle>
<section class="container section">
    <span class="eyebrow">Planes</span>
    <h1>Encuentra el plan adecuado</h1>
    <p class="muted">Precios mensuales orientativos, sin IVA. La contratación requiere que el plan esté configurado y activo.</p>
    @if (_loading)
    {
        <p role="status">Cargando planes…</p>
    }
    else if (_error)
    {
        <div class="notice" role="alert">No podemos mostrar los planes ahora mismo. Inténtalo más tarde.</div>
    }
    else if (_plans.Count == 0)
    {
        <p>No hay planes disponibles actualmente.</p>
    }
    else
    {
        <div class="cards">
            @foreach (var plan in _plans)
            {
                <article class="card" @key="plan.Code">
                    <h2>@plan.Name</h2>
                    @if (GetOffer(plan.Code) is { } offer)
                    {
                        <p><strong>@offer.Price</strong> <span class="muted">/mes, sin IVA</span></p>
                        <p class="muted">@offer.Details</p>
                    }
                    else
                    {
                        <p class="muted">Consulta las condiciones del plan.</p>
                    }
                    <a class="button" href="/registro">Crear cuenta</a>
                </article>
            }
        </div>
    }
</section>
@code {
    private sealed record Offer(string Price, string Details);
    private static Offer? GetOffer(string code) => code.Trim().ToLowerInvariant() switch
    {
        "gratis" or "free" => new("0 €", "1 empresa · 1 usuario · hasta 5 facturas/mes"),
        "autonomo" or "autónomo" => new("5,90 €", "1 empresa · 1 usuario · hasta 50 facturas/mes"),
        "negocio" => new("12,90 €", "2 empresas · 3 usuarios · hasta 300 facturas/mes"),
        "empresa" => new("24,90 €", "5 empresas · 10 usuarios · hasta 1.000 facturas/mes"),
        "asesoria" or "asesoría" => new("Desde 39 €", "Hasta 10 empresas gestionadas"),
        _ => null
    };
    private List<PlanResponse> _plans = [];
    private bool _loading = true;
    private bool _error;

    protected override async Task OnInitializedAsync()
    {
        try { _plans = await PlansService.GetActiveAsync(); }
        catch { _error = true; }
        finally { _loading = false; }
    }
}
