@page "/precios"
@using Facturacion.Application.Billing
@using Facturacion.Web.Public.Services
@inject PublicPlansService PlansService
<PageTitle>Planes | Facturación ES</PageTitle>
<section class="container section">
    <span class="eyebrow">Planes</span>
    <h1>Encuentra el plan adecuado</h1>
    <p class="muted">Precios mensuales, sin IVA. La contratación requiere que el plan esté configurado y activo.</p>
    @if (_loading)
    {
        <p role="status">Cargando planes…</p>
    }
    else if (_error)
    {
        <div class="notice" role="alert">No podemos mostrar los planes ahora mismo. Inténtalo más tarde.</div>
    }
    else if (_plans.Count == 0)
    {
        <p>No hay planes disponibles actualmente.</p>
    }
    else
    {
        <div class="cards">
            @foreach (var plan in _plans)
            {
                <article class="card" @key="plan.Code">
                    <h2>@plan.Name</h2>
                    <p><strong>@plan.MonthlyPrice.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("es-ES")) @CurrencySymbol(plan.Currency)</strong> <span class="muted">/mes, sin IVA</span></p>
                    @if (!string.IsNullOrWhiteSpace(plan.Description))
                    {
                        <p class="muted">@plan.Description</p>
                    }
                    <p class="muted">@PlanLimits(plan)</p>
                    <a class="button" href="/registro">Crear cuenta</a>
                </article>
            }
        </div>
    }
</section>
@code {
    private static string CurrencySymbol(string currency) =>
        string.Equals(currency, "EUR", StringComparison.OrdinalIgnoreCase) ? "€" : currency;

    private static string PlanLimits(PlanResponse plan)
    {
        var parts = new List<string>();
        if (plan.MaxCompanies > 0) parts.Add($"{plan.MaxCompanies} empresa(s)");
        if (plan.MaxUsers > 0) parts.Add($"{plan.MaxUsers} usuario(s)");
        if (plan.MaxInvoicesPerMonth > 0) parts.Add($"hasta {plan.MaxInvoicesPerMonth:N0} facturas/mes");
        return string.Join(" · ", parts);
    }
    private List<PlanResponse> _plans = [];
    private bool _loading = true;
    private bool _error;

    protected override async Task OnInitializedAsync()
    {
        try { _plans = await PlansService.GetActiveAsync(); }
        catch { _error = true; }
        finally { _loading = false; }
    }
}
