@using Facturacion.Client

@if (Customers is null)
{
    <p class="muted">Cargando clientes…</p>
}
else if (Customers.Count > 0)
{
    <table class="data-table customer-data-table">
        <thead>
            <tr>
                <th scope="col">Cliente</th>
                <th scope="col">NIF / Identificación fiscal</th>
                <th scope="col">Ciudad</th>
                <th scope="col">Correo electrónico</th>
                <th scope="col" class="customer-actions-heading">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in Customers)
            {
                <tr>
                    <td class="customer-name">@customer.LegalName</td>
                    <td>@customer.TaxId</td>
                    <td>@(string.IsNullOrWhiteSpace(customer.City) ? "—" : customer.City)</td>
                    <td>@(string.IsNullOrWhiteSpace(customer.Email) ? "—" : customer.Email)</td>
                    <td class="customer-row-actions">
                        <button type="button" class="customer-text-button" @onclick="() => OnEdit.InvokeAsync(customer)">Editar</button>
                        <button type="button" class="customer-text-button customer-delete-button" @onclick="() => OnDelete.InvokeAsync(customer.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public IReadOnlyList<CustomerDto>? Customers { get; set; }
    [Parameter] public EventCallback<CustomerDto> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
}
