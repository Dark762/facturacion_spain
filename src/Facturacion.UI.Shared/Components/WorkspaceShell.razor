@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Options
@using Facturacion.Configuration.Options
@implements IAsyncDisposable
@inject IOptions<SessionOptions> SessionSettings
@inject NavigationManager Navigation

@if (_warningOpen)
{
    <div class="session-idle-backdrop">
        <section class="session-idle-dialog" role="alertdialog" aria-modal="true" aria-labelledby="session-idle-title">
            <h2 id="session-idle-title">¿Sigues ahí?</h2>
            <p>Tu sesión se cerrará por inactividad si no continúas trabajando.</p>
            <p class="session-idle-countdown">Tiempo restante: <strong>@_remainingSeconds</strong> segundos</p>
            <div class="session-idle-actions">
                <button type="button" class="button button-outline" @onclick="EndSession">Cerrar sesión</button>
                <button type="button" class="button" @onclick="ContinueSession">Continuar sesión</button>
            </div>
        </section>
    </div>
}
<div class="shell" @onpointerdown="RegisterActivity" @onkeydown="RegisterActivity" @onwheel="RegisterActivity">
    <aside class="sidebar">
        <Brand />
        <nav class="sidebar-links" aria-label="Navegación privada">
            <a class="sidebar-link" href="/"><NavigationIcon Name="home" /> <span>Inicio</span></a>
            <span class="sidebar-link sidebar-link-disabled"><NavigationIcon Name="invoice" /> <span>Facturas <small>Próximamente</small></span></span>
            <a class="sidebar-link" href="/customers"><NavigationIcon Name="users" /> <span>Clientes</span></a>
            <span class="sidebar-link sidebar-link-disabled"><NavigationIcon Name="building" /> <span>Empresas <small>Próximamente</small></span></span>
            <a class="sidebar-link" href="/account"><NavigationIcon Name="account" /> <span>Mi perfil y seguridad</span></a>
        </nav>
        <div class="sidebar-footer">
            <button type="button" class="sidebar-link sidebar-logout" @onclick="OpenLogout"><NavigationIcon Name="logout" /> <span>Cerrar sesión</span></button>
        </div>
    </aside>
    <div class="workspace-column">
        @HeaderContent
        <main class="workspace">@ChildContent</main>
    </div>
</div>
<nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/"><NavigationIcon Name="home" /><span>Inicio</span></a>
    <a href="/customers"><NavigationIcon Name="users" /><span>Clientes</span></a>
    <a href="/account"><NavigationIcon Name="account" /><span>Mi cuenta</span></a>
    <button type="button" class="mobile-logout" @onclick="OpenLogout"><NavigationIcon Name="logout" /><span>Salir</span></button>
</nav>
<LogoutConfirmation IsOpen="_logoutOpen" OnCancel="CloseLogout" />

@code {
    private DateTimeOffset _lastActivity = DateTimeOffset.UtcNow;
    private bool _warningOpen;
    private int _remainingSeconds;
    private CancellationTokenSource? _timerCancellation;
    private bool _logoutOpen;
    protected override void OnInitialized()
    {
        _timerCancellation = new CancellationTokenSource();
        _ = WatchInactivityAsync(_timerCancellation.Token);
    }
    private void RegisterActivity()
    {
        if (!_warningOpen) _lastActivity = DateTimeOffset.UtcNow;
    }
    private void ContinueSession()
    {
        _warningOpen = false;
        _lastActivity = DateTimeOffset.UtcNow;
        // Navegación real para que ASP.NET Core compruebe y renueve la cookie.
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
    private void EndSession() => Navigation.NavigateTo("/session/ended?reason=inactive", forceLoad: true);
    private async Task WatchInactivityAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var elapsed = DateTimeOffset.UtcNow - _lastActivity;
                var timeout = TimeSpan.FromMinutes(SessionSettings.Value.IdleTimeoutMinutes);
                var remaining = timeout - elapsed;
                if (remaining <= TimeSpan.Zero)
                {
                    await InvokeAsync(EndSession);
                    return;
                }
                var warn = remaining <= TimeSpan.FromSeconds(SessionSettings.Value.WarningBeforeSeconds);
                var seconds = Math.Max(0, (int)Math.Ceiling(remaining.TotalSeconds));
                if (warn != _warningOpen || (warn && seconds != _remainingSeconds))
                {
                    await InvokeAsync(() => { _warningOpen = warn; _remainingSeconds = seconds; StateHasChanged(); });
                }
            }
        }
        catch (OperationCanceledException) { }
    }
    public ValueTask DisposeAsync()
    {
        _timerCancellation?.Cancel();
        _timerCancellation?.Dispose();
        return ValueTask.CompletedTask;
    }
    private void OpenLogout() => _logoutOpen = true;
    private void CloseLogout() => _logoutOpen = false;
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set; }
}
