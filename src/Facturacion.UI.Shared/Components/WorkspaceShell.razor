<div class="shell">
    <aside class="sidebar">
        <Brand />
        <nav class="sidebar-links" aria-label="Navegación privada">
            <a class="sidebar-link" href="/"><NavigationIcon Name="home" /> <span>Inicio</span></a>
            <span class="sidebar-link sidebar-link-disabled"><NavigationIcon Name="invoice" /> <span>Facturas <small>Próximamente</small></span></span>
            <span class="sidebar-link sidebar-link-disabled"><NavigationIcon Name="users" /> <span>Clientes <small>Próximamente</small></span></span>
            <span class="sidebar-link sidebar-link-disabled"><NavigationIcon Name="building" /> <span>Empresas <small>Próximamente</small></span></span>
            <a class="sidebar-link" href="/account"><NavigationIcon Name="account" /> <span>Mi perfil y seguridad</span></a>
        </nav>
        <div class="sidebar-footer">
            <a class="sidebar-link sidebar-logout" href="/account?confirmLogout=1"><NavigationIcon Name="logout" /> <span>Cerrar sesión</span></a>
        </div>
    </aside>
    <main class="workspace">@ChildContent</main>
</div>
<nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/"><NavigationIcon Name="home" /><span>Inicio</span></a>
    <a href="/account"><NavigationIcon Name="account" /><span>Mi cuenta</span></a>
    <a href="/account?confirmLogout=1"><NavigationIcon Name="logout" /><span>Salir</span></a>
</nav>

@code {
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
}
