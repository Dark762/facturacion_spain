{
  "Database": {
    "Provider": "MySql",
    "ConnectionStringName": "Default"
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "Facturacion.Api",
    "Audience": "Facturacion.Client",
    "ExpiryMinutes": 15,
    "SigningKey": ""
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "SuccessUrl": "https://app.tudominio.com/alta/completada?session_id={CHECKOUT_SESSION_ID}",
    "CancelUrl": "https://app.tudominio.com/planes"
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "no-reply@tudominio.com",
    "FromName": "Facturacion SaaS",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "EnableSsl": true
    }
  },
  "Frontend": {
    "BaseUrl": "https://app.tudominio.com",
    "VerifyEmailPath": "/verificar-email",
    "AcceptInvitationPath": "/aceptar-invitacion"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
